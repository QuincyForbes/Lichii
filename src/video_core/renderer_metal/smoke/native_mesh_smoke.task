// lichii-metal-smoke: a task program as a Metal object function. It hands each of the two mesh
// workgroups it launches a colour through the payload.

#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 32) in;

struct Payload {
    vec4 colors[2];
};
taskPayloadSharedEXT Payload payload;

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        payload.colors[0] = vec4(0.0, 1.0, 0.0, 1.0);
        payload.colors[1] = vec4(0.0, 0.0, 1.0, 1.0);
    }
    barrier();
    EmitMeshTasksEXT(2u, 1u, 1u);
}

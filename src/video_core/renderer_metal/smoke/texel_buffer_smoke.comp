// lichii-metal-smoke: a texel buffer read through the translator's texture_buffer.

#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform samplerBuffer source;

layout(set = 0, binding = 1) buffer Data {
    float values[];
};

void main() {
    const uint index = gl_GlobalInvocationID.x;
    values[index] = texelFetch(source, int(index)).x * 2.0;
}

// lichii-metal-smoke: a compute program that reads the subgroup size.

#version 450
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer Output {
    uint size[];
};

void main() {
    size[gl_GlobalInvocationID.x] = gl_SubgroupSize;
}

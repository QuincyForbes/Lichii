// lichii-metal-smoke: SPIR-V -> MSL (metal_shader_translate) -> Metal, run and read back.

#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform Params {
    uint multiplier;
    uint addend;
};

layout(set = 0, binding = 1) buffer Data {
    uint values[];
};

void main() {
    const uint index = gl_GlobalInvocationID.x;
    values[index] = index * multiplier + addend;
}

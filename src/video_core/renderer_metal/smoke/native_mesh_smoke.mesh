// lichii-metal-smoke: a mesh program as a Metal mesh function. Workgroup 0 covers the left half
// of the target, workgroup 1 the right half, each with two triangles in the payload's colour.

#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 4) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;

struct Payload {
    vec4 colors[2];
};
taskPayloadSharedEXT Payload payload;

layout(location = 0) out vec4 out_color[];

void main() {
    const uint group = gl_WorkGroupID.x;
    const uint vertex = gl_LocalInvocationIndex;
    SetMeshOutputsEXT(4u, 2u);
    const float left = group == 0u ? -1.0 : 0.0;
    const float x = left + ((vertex == 1u || vertex == 2u) ? 1.0 : 0.0);
    const float y = vertex >= 2u ? 1.0 : -1.0;
    gl_MeshVerticesEXT[vertex].gl_Position = vec4(x, y, 0.0, 1.0);
    out_color[vertex] = payload.colors[group & 1u];
    if (vertex < 2u) {
        gl_PrimitiveTriangleIndicesEXT[vertex] =
            vertex == 0u ? uvec3(0u, 1u, 2u) : uvec3(0u, 2u, 3u);
    }
}

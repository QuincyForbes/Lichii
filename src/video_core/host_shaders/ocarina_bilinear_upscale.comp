#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D scene;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D guest_color;
layout(push_constant) uniform Region {
    vec2 scene_scale; // the scene's extent over its image's size
};

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(guest_color);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    // The scene is square-root encoded; the game's upscale squares it into the linear target.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent) * scene_scale;
    vec3 color = max(textureLod(scene, uv, 0).rgb, vec3(0.0));
    imageStore(guest_color, pixel, vec4(color * color, 1.0));
}
